  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "postbuild": "node -e \"const fs=require('fs');fs.cpSync('.next/static','.next/standalone/.next/static',{recursive:true});try{fs.cpSync('public','.next/standalone/public',{recursive:true})}catch(e){}\"",
    "start": "npm run db:deploy && HOSTNAME=0.0.0.0 PORT=3000 node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:seed": "npx tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
