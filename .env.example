# ====================================================================
# Taswerak | تصويرك — Environment Variables (Template)
# Copy to .env and fill in REAL values. NEVER commit your .env file.
# No secrets are stored in this template — every placeholder is a
# description, not a real value.
# ====================================================================

# -------- App --------
NODE_ENV=development
# Public base URL of the app. Must be HTTPS in production.
NEXTAUTH_URL=http://localhost:3000
# Random ≥32-char secret used to sign auth tokens. Generate with:
#   openssl rand -base64 48
AUTH_SECRET=
# Legacy alias (optional). If you set AUTH_SECRET, leave this empty.
NEXTAUTH_SECRET=
HOSTNAME=0.0.0.0
PORT=3000

# Trust the X-Forwarded-For header set by your reverse proxy (Coolify /
# Nginx). Set to "true" only if you are behind a trusted proxy.
TRUST_PROXY=false

# -------- Database (PostgreSQL only) --------
# Pool URL (used by Prisma Client at runtime — pgbouncer or direct)
DATABASE_URL=
# Direct URL (used by Prisma Migrate — must bypass pgbouncer)
DIRECT_URL=

# -------- Auth.js v5 --------
AUTH_TRUST_HOST=true
# Optional OAuth (disabled by default — manual flow is primary)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# -------- Storage --------
# auto = use MinIO if MINIO_ACCESS_KEY present, else local
# minio = force MinIO (refuses to fall back to local)
# local = force local filesystem (mount a persistent volume!)
STORAGE_PROVIDER=auto
# When using local storage in production, mount a persistent volume here.
LOCAL_STORAGE_DIR=.upload

# -------- MinIO (S3-compatible object storage) --------
MINIO_ENDPOINT=http://localhost:9000
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=taswerak-uploads
MINIO_PUBLIC_URL=http://localhost:9000

# -------- Email --------
EMAIL_FROM="Taswerak <no-reply@taswerak.com>"
# simulation | smtp  (simulation is forbidden in production)
EMAIL_TRANSPORT=simulation
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# -------- Bank Details (shown to students on manual payment page) --------
BANK_NAME=البنك الأهلي السعودي
BANK_ACCOUNT_NAME=
BANK_IBAN=
BANK_ACCOUNT_NUMBER=

# -------- App Branding --------
APP_NAME=تصويرك
APP_NAME_EN=Taswerak
APP_LOGO_URL=/logo.png
APP_GRADIENT_FROM=#0A9ED9
APP_GRADIENT_MID=#00A3AA
APP_GRADIENT_TO=#D65221
APP_CITY=جدة
APP_COUNTRY=السعودية

# -------- Feature Flags --------
ENABLE_SIGNUP=true
ENABLE_IMPERSONATION=true
ENABLE_CERTIFICATES=true
# Demo seed creates instructor + student + sample courses.
# FORBIDDEN in production. Set to "true" only in dev/staging.
ENABLE_DEMO_SEED=false

# -------- Production-only seed admin --------
# Required when running `npm run db:seed` in production.
# SEED_ADMIN_PASSWORD must be ≥12 chars and not match common patterns.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
SEED_ADMIN_PHONE=

# -------- Payment Gateways --------
# Default gateway at checkout (manual | moyasar | tap)
PAYMENT_GATEWAY=manual

# Moyasar (https://moyasar.com)
MOYASAR_SECRET_KEY=
MOYASAR_PUBLIC_KEY=
# Webhook secret configured in the Moyasar dashboard. REQUIRED when
# PAYMENT_GATEWAY=moyasar — without it, callbacks are rejected.
MOYASAR_WEBHOOK_SECRET=

# Tap (https://tap.company)
# TAP_SECRET_KEY is used for BOTH API auth AND webhook signature
# verification. Tap signs webhooks with HMAC-SHA256 of a hashstring
# built from charge fields (x_id, x_amount, x_currency,
# x_gateway_reference, x_payment_reference, x_status, x_created),
# signed with this same key. There is NO separate webhook secret.
TAP_SECRET_KEY=
TAP_MERCHANT_ID=

# -------- Rate limiting (optional) --------
# If set, rate limiting uses Redis instead of in-memory. Required when
# running multiple replicas behind a load balancer.
# REDIS_URL=

# -------- WhatsApp (Whapi.cloud or Meta Cloud API) --------
WHAPI_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NUMBER=

# -------- Google Analytics 4 --------
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# -------- Sentry (error tracking) --------
SENTRY_DSN=

# -------- Google Search Console verification --------
GOOGLE_SITE_VERIFICATION=
